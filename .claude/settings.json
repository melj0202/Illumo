{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format_changed_lines.py"],
            "timeout": 30,
            "statusMessage": "Formatting changed lines"
          }
        ]
      }
    ]
  }
}
