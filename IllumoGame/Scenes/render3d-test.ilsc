{
  "format": "ilsc",
  "format_version": [2, 0],
  "metadata": {
    "title": "render3dTest",
    "description": "IllumoGame's 3D rendering diagnostic. The game animates the nodes 'orbit' and 'child' by id."
  },
  "settings": {
    "world_mode": "3d"
  },
  "nodes": [
    { "id": "root", "name": "Root" },
    { "id": "ground", "name": "Ground", "parent": "root",
      "transform": { "position": [0, -0.05, 0] },
      "components": [ { "type": "primitive", "shape": "cube", "extent": [5, 0.05, 5], "color": [72, 96, 128, 255] } ] },
    { "id": "axis-x", "name": "X axis", "parent": "root",
      "transform": { "position": [1.5, 0.02, 0] },
      "components": [ { "type": "primitive", "shape": "cube", "extent": [1.5, 0.02, 0.02], "color": [220, 70, 70, 255] } ] },
    { "id": "axis-y", "name": "Y axis", "parent": "root",
      "transform": { "position": [0, 1.5, 0] },
      "components": [ { "type": "primitive", "shape": "cube", "extent": [0.02, 1.5, 0.02], "color": [70, 210, 95, 255] } ] },
    { "id": "axis-z", "name": "Z axis", "parent": "root",
      "transform": { "position": [0, 0.02, 1.5] },
      "components": [ { "type": "primitive", "shape": "cube", "extent": [0.02, 0.02, 1.5], "color": [70, 120, 230, 255] } ] },
    { "id": "orbit", "name": "Orbit", "parent": "root",
      "components": [ { "type": "primitive", "shape": "cube", "extent": [0.375, 0.375, 0.375], "color": [255, 180, 72, 255] } ] },
    { "id": "orbit-frame", "name": "Orbit frame", "parent": "orbit",
      "components": [ { "type": "primitive", "shape": "wire_cube", "extent": [0.5, 0.5, 0.5], "color": [224, 244, 255, 255] } ] },
    { "id": "child", "name": "Child", "parent": "orbit",
      "components": [ { "type": "primitive", "shape": "cube", "extent": [0.175, 0.175, 0.175], "color": [100, 220, 255, 255] } ] },
    { "id": "child-frame", "name": "Child frame", "parent": "child",
      "components": [ { "type": "primitive", "shape": "wire_cube", "extent": [0.225, 0.225, 0.225], "color": [255, 255, 255, 255] } ] }
  ]
}
